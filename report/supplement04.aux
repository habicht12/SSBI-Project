\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces t-SNE on the 5,000-cell sweep subset. Left to right: perplexities 5, 30, 50, 60, 70 and 100; numerical quality measures are in Table~\ref {tab:tsnesweep}. Red: CMV-positive donors; blue: negative donors. Perplexity changes the neighbourhood scale and visual organisation. The layouts are not independently annotated populations.}}{4}{figure.caption.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces All three pairwise comparisons of the final 40,000-cell embeddings. t-SNE/UMAP has both the highest neighbour overlap and lowest Procrustes disparity.}}{4}{table.caption.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces UMAP on the 5,000-cell sweep subset at learning rate 0.1. Rows: 5, 15, 50 and 100 neighbours; columns: minimum distance 0, 0.1, 0.5 and 1. Red: CMV-positive donors; blue: negative donors. Smaller minimum distance packs cells more tightly, while neighbour count changes local connectivity.}}{5}{figure.caption.10}\protected@file@percent }
