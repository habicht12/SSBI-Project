\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Marker evidence for the selected k-means, Ward and Leiden solutions on 20,000 live PBMCs. Twelve markers share one relative-IQR scale with colours clipped at $\pm 2$. Cluster IDs are local to each method. DB is evaluated in 37D. Stability comes from the original ten cell-subsampling repeats. Full profiles appear in Supplement~S2.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:clusters}{{2}{3}{Marker evidence for the selected k-means, Ward and Leiden solutions on 20,000 live PBMCs. Twelve markers share one relative-IQR scale with colours clipped at $\pm 2$. Cluster IDs are local to each method. DB is evaluated in 37D. Stability comes from the original ten cell-subsampling repeats. Full profiles appear in \supp {S2}}{figure.caption.2}{}}
